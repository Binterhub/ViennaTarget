# DataMatcherAPI connection (required for live data)
DATAMATCHER_API_URL=https://your-datamatcher-api.example.com
DATAMATCHER_API_KEY=your-api-key-here

# Server
PORT=3000
NODE_ENV=production

# In-memory cache TTL in minutes (default: 15)
CACHE_TTL_MINUTES=15

# Upstream request timeout in milliseconds (default: 30000)
API_TIMEOUT_MS=30000
