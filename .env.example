# DataMatcherAPI connection (required for live data)
DATAMATCHER_API_URL=https://your-datamatcher-api.example.com
DATAMATCHER_API_KEY=your-api-key-here

# App login gate (required)
APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Server
PORT=3000
NODE_ENV=production

# Optional: country filter for doctor search (default Austria)
SEARCH_COUNTRY=Austria

# Set to 1 to serve local fixture doctors when API URL/key are missing (UI demos)
USE_MOCK_DATA=0

# In-memory cache TTL in minutes (default: 15)
CACHE_TTL_MINUTES=15

# Upstream request timeout in milliseconds (default: 30000)
API_TIMEOUT_MS=30000
